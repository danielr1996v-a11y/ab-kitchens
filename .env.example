# משתני סביבה - שמות בלבד. הערכים מוזנים ב-Vercel (Settings → Environment
# Variables) ובקובץ .env.local במחשב. ⚠️ לעולם לא בקוד, ב-git או בצ'אט.

# ===== מערכת הניהול =====
# מחרוזת אקראית של 32 תווים לפחות. חותמת את עוגיית הכניסה.
# יצירה: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# מסד הנתונים בענן (Turso). ריק = קובץ מקומי ב-.data/ (פיתוח בלבד)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# אחסון התמונות בענן (Vercel Blob). ריק = קבצים מקומיים ב-.data/ (פיתוח)
BLOB_READ_WRITE_TOKEN=

# סוד ל-Vercel Cron (סנכרון ערוץ היוטיוב פעם ביום). מחרוזת אקראית
CRON_SECRET=

# ייבוא התוכן מהקוד למסד בענן - רק באישור דניאל. 1 = מותר
ADMIN_ALLOW_IMPORT=

# כתובת האתר - לקישור שהסקריפט create-admin מדפיס. ריק = localhost
ADMIN_BASE_URL=

# ===== טפסים =====
# אין משתנים: המייל נשלח מהדפדפן דרך FormSubmit (lib/lead.ts), והיעד
# נקבע במסך ההגדרות במערכת ("מייל לפניות").

# ===== Sanity (יוסר בסוף ההעברה) =====
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_TOKEN=
